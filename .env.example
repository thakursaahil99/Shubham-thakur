# Copy this file to .env.local and fill in the values (never commit .env.local)

# Brevo → SMTP & API → API Keys → "Generate a new API key"
BREVO_API_KEY=

# Must be a sender verified in Brevo → Senders, Domains & Dedicated IPs → Senders
BREVO_SENDER_EMAIL=

# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=shubhamsaklani437@gmail.com
